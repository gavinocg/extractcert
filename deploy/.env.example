# Copiar a backend/.env y completar. Generar SECRET_KEY con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=mysql+pymysql://extract:__CLAVE__@__IP_MARIADB__:3306/db_extract_py
SECRET_KEY=__CAMBIAR_POR_VALOR_ALEATORIO_LARGO__
DEFAULT_RAIZ_ORIGEN=/datos/origen
DEFAULT_RAIZ_REPO=/datos/repo
APP_URL=https://extractcert.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=__USUARIO_SMTP__
SMTP_PASS=__CLAVE_SMTP__
SMTP_TLS=true
SMTP_FROM=extractcert@example.com
